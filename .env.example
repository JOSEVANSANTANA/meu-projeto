# ============================================================
# ESF News Monitor — Configuração local
# Copie este arquivo para `.env` na RAIZ do projeto e preencha.
# O arquivo .env está no .gitignore e nunca deve ser commitado.
# ============================================================

# Chave(s) da API do Google Gemini (obrigatória). Pode ser UMA ou VÁRIAS
# separadas por vírgula — o app rotaciona para a próxima quando uma esgota.
# Também dá para adicionar chaves em runtime no topo direito do dashboard.
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_CHAVE_AQUI

# Ativo/índice prioritário das análises (também ajustável na UI).
PRIORITY_ASSET=S&P 500 Futuro (ES)

# Modelo(s) Gemini. Pode ser uma LISTA separada por vírgula (fallback: se um
# der 404, tenta o próximo). Vazio = usa a cascata padrão. No startup o app
# imprime no log os modelos que a sua chave aceita.
GEMINI_MODEL=

# Intervalo mínimo entre chamadas ao Gemini (ms) — evita 429 no nível gratuito.
GEMINI_MIN_INTERVAL_MS=6000

# Máximo de análises novas por ciclo — suaviza rajadas (anti-429).
MAX_ANALYSES_PER_CYCLE=6

# Autoaprendizagem: horizonte (s) após o qual uma predição é pontuada contra o
# preço real (Yahoo). Padrão 1200s (20 min) — cobre o atraso da cotação.
SCORE_HORIZON_SECS=1200

# Intervalo base entre ciclos de scraping (segundos)
SCRAPE_INTERVAL_SECS=30

# Idade máxima (horas) que uma notícia pode ter para ser tratada como "em
# tempo real". Acima disso é descartada — protege contra feeds que
# resurfaceiam itens antigos (ex.: cache defasado, busca "últimas 48h").
# Itens sem data conhecida no feed não são afetados por este filtro.
MAX_NEWS_AGE_HOURS=24

# Delays aleatórios anti-bot entre requisições (milissegundos)
MIN_REQUEST_DELAY_MS=2000
MAX_REQUEST_DELAY_MS=5000

# Opcional: feeds RSS extras, além dos padrões (Fed, BLS, MarketWatch, CNBC).
# Formato: "Nome|url,Nome|url"
# RSS_FEEDS=Yahoo Finance|https://finance.yahoo.com/news/rssindex

# ---------------- TRUTH SOCIAL ----------------
# Camada 1 (LIGADA): espelho público dos posts do Trump (sem login, sem risco).
# Troque a URL se quiser outro espelho/feed. TRUMP_FILTER=0 desliga o filtro
# de relevância (passa TODOS os posts do Trump).
# TRUMP_MIRROR_RSS_URL=https://trumpstruth.org/feed
# TRUMP_FILTER=1
#
# Camada 2 (OPCIONAL/DESLIGADA): conector LOGADO na SUA conta para o feed de
# quem você segue. ⚠️ Viola os ToS do Truth Social (risco de suspensão da conta),
# é frágil (Cloudflare) e exige `pip install curl_cffi`. Preencha para ligar:
# TRUTHSOCIAL_USERNAME=
# TRUTHSOCIAL_PASSWORD=
# (ou, em vez de usuário/senha, um token pronto:)
# TRUTHSOCIAL_TOKEN=
# Handles específicos (vazio = home timeline de quem você segue):
# TRUTHSOCIAL_HANDLES=realDonaldTrump
# TRUTHSOCIAL_LIMIT=20
# Caminho do script/python (se não estiver na raiz do projeto):
# TRUTH_CONNECTOR_PATH=truth_connector.py
# TRUTH_PYTHON=python3

# Investing.com fica atrás do Cloudflare (403 a scrapers simples) -> DESLIGADO.
# Só ative se tiver um contorno (proxy/navegador headless).
# ENABLE_INVESTING=0

# ---------------- CALENDÁRIO ECONÔMICO ----------------
# Fonte: ForexFactory (pública, sem chave). Eventos de alto/médio impacto
# (CPI, NFP, decisões de juros, PIB, etc.) geram um aviso PRÉVIO com
# forecast/previous reais assim que a divulgação entra nesta janela de
# antecedência (minutos). O valor "actual" nunca é inventado — chega depois
# pelas manchetes normais (Reuters/Bloomberg/CNBC/WSJ) já ingeridas.
CALENDAR_LOOKAHEAD_MINUTES=30
