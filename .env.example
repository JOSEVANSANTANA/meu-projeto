# ============================================================
# ESF News Monitor — Configuração local
# Copie este arquivo para `.env` na RAIZ do projeto e preencha.
# O arquivo .env está no .gitignore e nunca deve ser commitado.
# ============================================================

# Chave da API do Google Gemini (obrigatória)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_CHAVE_AQUI

# Modelo Gemini usado na análise (flash = latência baixa, ideal p/ pregão)
GEMINI_MODEL=gemini-2.5-flash

# Intervalo base entre ciclos de scraping (segundos)
SCRAPE_INTERVAL_SECS=30

# Delays aleatórios anti-bot entre requisições (milissegundos)
MIN_REQUEST_DELAY_MS=2000
MAX_REQUEST_DELAY_MS=5000
